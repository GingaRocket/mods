<Project>
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>13.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WarningsAsErrors>nullable</WarningsAsErrors>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Deterministic>true</Deterministic>
    <VersionPrefix>1.0.0</VersionPrefix>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/festelo/mods</RepositoryUrl>

    <!-- ScriptHookDotNet is a mixed-mode assembly installed with the game. The environment
         variable/property keeps the repository portable. -->
    <GtaIvDirectory Condition="'$(GtaIvDirectory)' == '' and '$(GTAIV_DIR)' != ''">$(GTAIV_DIR)</GtaIvDirectory>
    <ScriptHookDotNetAssembly Condition="'$(ScriptHookDotNetAssembly)' == '' and '$(GtaIvDirectory)' != ''">$(GtaIvDirectory)\ScriptHookDotNet.asi</ScriptHookDotNetAssembly>
  </PropertyGroup>
</Project>
